<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      The app commits to a single dark "instrument panel" look in both
      light and dark system modes: the traces are only legible on a dark ground.
    -->
    <style name="Theme.IMU" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/amber</item>
        <item name="colorPrimaryVariant">@color/amber</item>
        <item name="colorOnPrimary">@color/ink</item>
        <item name="colorSecondary">@color/channel_z</item>
        <item name="colorSecondaryVariant">@color/channel_z</item>
        <item name="colorOnSecondary">@color/ink</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/ink</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/ink</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>
